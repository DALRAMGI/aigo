  "components": {
    "schemas": {
      "AnalysisIn": {
        "properties": {
          "filename": {
            "type": "string",
            "maxLength": 255,
            "minLength": 1,
            "title": "Filename"
          },
          "size": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Size"
          },
          "content_type": {
            "type": "string",
            "maxLength": 100,
            "title": "Content Type",
            "default": ""
          },
          "consent": {
            "type": "boolean",
            "title": "Consent"
          }
        },
        "type": "object",
        "required": [
          "filename",
          "size",
          "consent"
        ],
        "title": "AnalysisIn"
      },
      "ConfirmIn": {
        "properties": {
          "payment_key": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Payment Key"
          },
          "amount": {
            "type": "integer",
            "title": "Amount"
          }
        },
        "type": "object",
        "required": [
          "payment_key",
          "amount"
        ],
        "title": "ConfirmIn"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "OrderIn": {
        "properties": {
          "product_slug": {
            "type": "string",
            "title": "Product Slug"
          },
          "quantity": {
            "type": "integer",
            "maximum": 5.0,
            "minimum": 1.0,
            "title": "Quantity"
          },
          "recipient_name": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Recipient Name"
          },
          "phone": {
            "type": "string",
            "maxLength": 30,
            "minLength": 1,
            "title": "Phone"
          },
          "address": {
            "type": "string",
            "maxLength": 190,
            "minLength": 1,
            "title": "Address"
          },
          "address_detail": {
            "type": "string",
            "maxLength": 100,
            "title": "Address Detail",
            "default": ""
          }
        },
        "type": "object",
        "required": [
          "product_slug",
          "quantity",
          "recipient_name",
          "phone",
          "address"
        ],
        "title": "OrderIn"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
